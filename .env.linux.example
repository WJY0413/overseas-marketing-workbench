# Keep this installation and its data directory on persistent local storage.
WORKBENCH_DATA_DIR=./data
# DATABASE_URL=sqlite:////absolute/persistent/path/workbench.db
# Optional sources: use Linux paths, never a copied C:/ or D:/ path.
# BD_DATABASE_SQLITE_PATH=/absolute/persistent/path/bd_company_database.sqlite
# Blank selects the native LinkedIn database under WORKBENCH_DATA_DIR.
LINKEDIN_MASTER_SQLITE_PATH=
APP_TIMEZONE=Asia/Shanghai
PUBLIC_BASE_URL=http://127.0.0.1:8000
APP_ENVIRONMENT=linux-dot
APP_INSTANCE_NAME=Linux dot 1
ENABLE_OPEN_TRACKING=false
BOUNCE_SCAN_ENABLED=false
DRY_RUN_EMAIL=true
DEFAULT_SENDER_NAME=Your Name
