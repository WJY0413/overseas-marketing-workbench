# If DATABASE_URL is blank, the app uses WORKBENCH_DATA_DIR/workbench.db.
WORKBENCH_DATA_DIR=./data
# DATABASE_URL=sqlite:///./data/workbench.db

APP_TIMEZONE=Asia/Shanghai
PUBLIC_BASE_URL=http://127.0.0.1:8000
APP_ENVIRONMENT=local
APP_INSTANCE_NAME=Local Version

# Safe defaults for a shared copy.
ENABLE_OPEN_TRACKING=false
DRY_RUN_EMAIL=true
DEFAULT_SENDER_NAME=Your Name

# Add SMTP app passwords only on the recipient's own computer.
# SMTP_PASSWORD_PRIMARY=first_sender_password
# SMTP_PASSWORD_SECONDARY=second_sender_password
